PORT=5000
# Create a project + a "products" resource at https://mockapi.io, then paste
# the base endpoint it gives you here (it already ends in /products).
# Example: https://6683af2e1234567890abcde.mockapi.io/api/v1/products
MOCKAPI_BASE_URL=https://<your-project-id>.mockapi.io/api/v1/products
CACHE_TTL_SECONDS=60
CLIENT_ORIGIN=http://localhost:5173
